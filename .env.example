# OpenAI-compatible Chat Completions provider
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# One mailbox per installation. Port 587 uses STARTTLS, 465 uses implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Optional HTTP(S) proxy for Hugging Face requests only.
HF_PROXY_URL=
